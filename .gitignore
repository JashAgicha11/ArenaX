# =========================
# GLOBAL (Ignores these everywhere)
# =========================
# 1. Dependency folders
node_modules/
__pycache__/
venv/
.venv/

# 2. System Junk
.DS_Store
Thumbs.db

# 3. SECRETS (Crucial!)
# This ignores .env in root, backend, and frontend automatically
.env
.env.local
.env.production
.env.test
*.pem
*.key

# =========================
# FRONTEND SPECIFIC
# =========================
# Build outputs (React/Vue/Angular/Next)
dist/
build/
.next/
out/
coverage/

# =========================
# BACKEND SPECIFIC
# =========================
# Logs
*.log
npm-debug.log*
yarn-debug.log*

# Runtime data (if you use local file databases)
*.sqlite
*.db